# utilities/sweeper.env — per-user config for the test-bed + deploy utilities.
#
# Copy this file to utilities/sweeper.env and fill in your own values:
#   cp utilities/sweeper.env.example utilities/sweeper.env
#
# utilities/sweeper.env is git-ignored: it holds YOUR fork, GCP project, and
# dashboard — never commit it. The utility scripts (kill-run.sh,
# mirror-upstream-dependabot.sh) source it. Everything here can also be set as
# an environment variable or passed as a flag.

# --- Test bed (required) ---------------------------------------------------
# Your personal fork of the upstream monorepo. There is NO default — each user
# brings their own fork so runs never touch the shared upstream repo.
export FORK="you/taskcluster"

# The upstream repo the fork mirrors. Default is taskcluster/taskcluster.
# export UPSTREAM="taskcluster/taskcluster"

# --- GCP deployment (required only if you deploy to a VM) ------------------
# Your OWN GCP project — each user deploys to a separate project (avoids
# resource-name collisions like sweeper-vm). If unset, deploy/update.sh falls
# back to `gcloud config get-value project`.
# export PROJECT_ID="you-dependabot-sweeper"

# Your deployment's dashboard URL. Per-deployment;
# each VM gets its own static IP.
# export DASHBOARD_URL="http://YOUR.VM.IP:8080"

# Deploy resource names — defaults are fine when each user has their own project.
# export ZONE="europe-west1-b"
# export VM_NAME="sweeper-vm"
# export REGION="europe-west1"
# export AR_REPO="sweeper"

# --- Rarely changed --------------------------------------------------------
# Taskcluster root for cancelling CI task groups on the fork.
# export TASKCLUSTER_ROOT_URL="https://community-tc.services.mozilla.com"
# Committer identity the manual rebase uses (must match the worker's --bot-name).
# export BOT_NAME="dependabot-helper"
# Upstream dependabot author login.
# export DEPENDABOT_AUTHOR="app/dependabot"
